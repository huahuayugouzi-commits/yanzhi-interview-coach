{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "heard",
    "main_issue",
    "evidence_quote",
    "guiding_question",
    "retry_hints"
  ],
  "properties": {
    "status": {
      "enum": [
        "needs_retry",
        "clear",
        "insufficient"
      ]
    },
    "heard": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "main_issue": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_quote": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "guiding_question": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "retry_hints": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30,
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "clear"
          }
        }
      },
      "then": {
        "properties": {
          "main_issue": {
            "type": "null"
          },
          "guiding_question": {
            "type": "null"
          },
          "retry_hints": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "needs_retry",
              "insufficient"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "main_issue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "guiding_question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
