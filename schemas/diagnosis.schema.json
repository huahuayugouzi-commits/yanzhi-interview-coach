{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "heard",
    "capability_focus",
    "evidence_assessment",
    "issue_impact",
    "main_issue",
    "evidence_quote",
    "guiding_question",
    "retry_hints"
  ],
  "properties": {
    "status": {
      "enum": [
        "needs_retry",
        "clear",
        "insufficient"
      ]
    },
    "heard": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "capability_focus": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "evidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "reason"
      ],
      "properties": {
        "level": {
          "enum": [
            "sufficient",
            "partial",
            "insufficient"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800,
          "pattern": "\\S"
        }
      }
    },
    "issue_impact": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "main_issue": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_quote": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "guiding_question": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "retry_hints": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30,
        "pattern": "\\S"
      }
    },
    "expression_advice": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "\\S"
      }
    },
    "evidence_gap": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "thinking_hints": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[^?？\\r\\n]*[^\\s?？\\r\\n][^?？\\r\\n]*$"
      },
      "anyOf": [
        {
          "maxItems": 0
        },
        {
          "minItems": 2
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "clear"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_assessment": {
            "properties": {
              "level": {
                "const": "sufficient"
              }
            }
          },
          "issue_impact": {
            "type": "null"
          },
          "main_issue": {
            "type": "null"
          },
          "guiding_question": {
            "type": "null"
          },
          "retry_hints": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "needs_retry",
              "insufficient"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "main_issue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "guiding_question": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_gap": {
            "type": "null"
          },
          "thinking_hints": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "insufficient"
          }
        }
      },
      "then": {
        "properties": {
          "guiding_question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_retry"
          },
          "guiding_question": {
            "type": "null"
          }
        }
      },
      "then": {
        "required": [
          "expression_advice"
        ],
        "properties": {
          "expression_advice": {
            "minItems": 1
          },
          "evidence_assessment": {
            "properties": {
              "level": {
                "const": "sufficient"
              }
            }
          }
        }
      }
    }
  ]
}
