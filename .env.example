# One OpenAI-compatible Chat Completions service; no browser-side secrets.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# Optional OpenAI-compatible audio/transcriptions service; independent credential.
ASR_API_KEY=
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
PORT=3001
HOST=127.0.0.1
# Required for public production: private trial invitation code, minimum 12 characters.
ACCESS_CODE=
# Account login migration: code (shared trial code), supabase (account), or invite (independent quota codes).
# In supabase mode the old invitation code cannot access model APIs.
AUTH_MODE=code
# Supabase Free project URL and publishable/legacy anon key. NEVER use service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
HOURLY_LIMIT=20
DAILY_LIMIT=100

# Independent test invitations (persistent Supabase quotas). Set AUTH_MODE=invite after SQL setup.
# Keep this random server-only gateway secret out of source control and the browser.
INVITE_GATEWAY_SECRET=
